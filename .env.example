# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/getoken

# Railway Environment (Auto-set)
RAILWAY_ENVIRONMENT=production
RAILWAY_SERVICE_NAME=getoken

# Bot Configuration
BOT_ENABLED=true
BOT_INTERVAL_HOURS=24
MAX_ACCOUNTS_PER_DAY=1

# Anti-Detection
USE_PROXIES=true
PROXY_ROTATION=true
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=120

# Account Generation
DEFAULT_COUNTRY=DZ
GENERATE_REAL_PHOTOS=true
ACCOUNT_MATURITY_DAYS=14

# Task Execution
MAX_RATINGS_PER_ACCOUNT=15
RATING_INTERVAL_DAYS=3
MIN_STARS=3
MAX_STARS=5

# Web Application
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Facebook Configuration (Placeholders)
FACEBOOK_LOGIN_URL=https://www.facebook.com/login
FACEBOOK_SIGNUP_URL=https://www.facebook.com/r.php

# Monitoring
LOG_LEVEL=INFO
ENABLE_NOTIFICATIONS=true

# Free Proxy Sources
PROXY_SOURCES=https://www.sslproxies.org/,https://free-proxy-list.net/
